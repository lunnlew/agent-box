# OpenSpace 环境变量配置示例
# 复制此文件到 ~/.openspace/.env 并填写实际值

# ===========================================
# 云社区配置（可选）
# ===========================================
# 注册 https://open-space.cloud 获取 API Key
# 没有 API Key 时，本地功能（任务执行、进化、本地技能搜索）正常工作
OPENSPACE_API_KEY=sk-xxx

# ===========================================
# LLM API 配置
# ===========================================
# OpenSpace 会自动检测 Agent 的配置，通常无需手动设置
# 如果需要指定，可以设置以下变量：

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI
OPENAI_API_KEY=your-openai-key

# DashScope (Qwen)
DASHSCOPE_API_KEY=your-dashscope-key

# ===========================================
# 技能目录配置
# ===========================================
# Agent 的技能目录路径（用于技能发现和注入）
OPENSPACE_HOST_SKILL_DIRS=/home/agent/.claude/skills

# OpenSpace 工作目录
OPENSPACE_WORKSPACE=/home/agent/openspace-src

# ===========================================
# Dashboard 配置
# ===========================================
# Dashboard 后端端口
OPENSPACE_PORT=7788

# Dashboard 前端端口
OPENSPACE_FRONTEND_PORT=5174