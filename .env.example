# ===========================================
# AgentBox 环境变量配置
# ===========================================
# 复制此文件为 .env 并填写相应的值

# -------------------------------------------
# AI服务 API Key 配置
# -------------------------------------------
# Claude Code (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qwen Code (阿里云通义千问)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenCode / Codex (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Kilocode
KILOCODE_API_KEY=your_kilocode_api_key_here

# iFlow
IFLOW_API_KEY=your_iflow_api_key_here

# OpenClaw Gateway Token
# OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here

# 其他AI服务
# GOOGLE_API_KEY=your_google_api_key_here

# -------------------------------------------
# 镜像源配置 (加速下载)
# -------------------------------------------

# NPM 镜像源 (可选: taobao, npmmirror, tencent, huawei, 官方)
# 留空使用官方源
NPM_REGISTRY=https://registry.npmmirror.com

# PNPM 镜像源
PNPM_REGISTRY=https://registry.npmmirror.com

# PIP 镜像源 (可选: aliyun, tsinghua, tencent, douban, 官方)
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com

# Ubuntu APT 镜像源 (可选: aliyun, tsinghua, ustc, 163, 官方)
# 留空使用官方源
UBUNTU_MIRROR=aliyun

# GitHub 代理 (用于加速 GitHub 资源下载)
# 示例: https://mirror.ghproxy.com/ 或 https://ghproxy.com/
GITHUB_PROXY=

# HTTP/HTTPS 代理 (用于访问国外资源)
# 示例: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
HTTP_PROXY=
HTTPS_PROXY=

# 安装脚本代理 (用于 curl/wget 下载安装脚本)
# 示例: http://127.0.0.1:7890
INSTALL_PROXY=

# Go 模块代理
GOPROXY=https://goproxy.cn,direct

# Rust crates 镜像
# RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
# RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup-update-stable.toml

# -------------------------------------------
# 容器配置
# -------------------------------------------
TZ=Asia/Shanghai
# PUID=1000
# PGID=1000

# -------------------------------------------
# 端口配置
# -------------------------------------------
# 格式: ${环境变量:-默认值}，通过设置环境变量可自定义外部访问端口

# AgentBox Dashboard (容器内 8888)
BOARD_PORT=8888

# VS Code Server (容器内 8080)
VSCODE_PORT=8080
VSCODE_PASSWORD=agentbox

# Web Terminal (容器内 7681)
WEB_TERMINAL_PORT=7681

# OpenClaw Gateway (容器内 18789)
OPENCLAW_PORT=18789

# CoPaw Gateway (容器内 8088)
COPAW_PORT=8088

# noVNC / Skills Manager (容器内 6080)
NOVNC_PORT=6080

# HiClaw (独立 Docker 容器)
HICLAW_GATEWAY_PORT=18080
HICLAW_CONSOLE_PORT=18001
HICLAW_ELEMENT_PORT=18088

# -------------------------------------------
# OpenClaw 配置
# -------------------------------------------
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_SILENT_PAIRING=true